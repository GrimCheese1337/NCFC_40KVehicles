<?xml version="1.0" encoding="utf-8"?>

<Defs>
  <!-- Mote definition for laser flash animation -->
  <ThingDef ParentName="MoteBase">
    <defName>GF40K_Mote_LaserFlash</defName>
    <!-- References a custom Mote class for visual effects -->
    <thingClass>Vehicles.MoteCannonPlume</thingClass>

    <graphicData>
      <!-- Points to the texture folder -->
      <texPath>Animations/LaserFlash</texPath>

      <!-- Uses a custom animated graphic class -->
      <graphicClass>Vehicles.Graphic_Animate</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>

    <!-- Defines the altitude layer at which the mote is drawn -->
    <altitudeLayer>MoteOverhead</altitudeLayer>

    <mote>
      <!-- Times for fade in, solid display, and fade out (in seconds, presumably) -->
      <fadeInTime>0</fadeInTime>
      <solidTime>1</solidTime>
      <fadeOutTime>0</fadeOutTime>

      <!-- Growth rate for size over time (0 means no growth) -->
      <growthRate>0</growthRate>
    </mote>
  </ThingDef>


  <!-- Mote definition for rocket flash animation -->
  <ThingDef ParentName="MoteBase">
    <defName>GF40K_Mote_RocketFlash</defName>
    <thingClass>Vehicles.MoteCannonPlume</thingClass>

    <graphicData>
      <texPath>Animations/RocketFlash</texPath>
      <graphicClass>Vehicles.Graphic_Animate</graphicClass>
      <drawSize>(5.5,5.5)</drawSize>
    </graphicData>

    <altitudeLayer>MoteOverhead</altitudeLayer>

    <mote>
      <fadeInTime>0</fadeInTime>
      <solidTime>1</solidTime>
      <fadeOutTime>0</fadeOutTime>
      <growthRate>0</growthRate>
    </mote>
  </ThingDef>
</Defs>
